# RPC Configuration
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Wallet Configuration
WALLET_PATH=config/wallet.json

# Twitter API (Optional - for real sentiment analysis)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# Risk Management Parameters
TAKE_PROFIT_PERCENTAGE=100
INITIAL_STOP_LOSS_PERCENTAGE=30
TRAILING_STOP_PERCENTAGE=15
MAX_OPEN_POSITIONS=5
MAX_POSITION_SIZE=1000000000

# Trading Parameters
DEFAULT_SLIPPAGE=100
DEFAULT_PRIORITY_FEE=1000
